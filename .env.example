# Copie para .env e preencha com os valores do painel do EmailJS e do Google reCAPTCHA.
# São chaves públicas (vão para o bundle do navegador), mas o .env continua fora do git.

# EmailJS > Email Services
VITE_SERVICE_ID=
# EmailJS > Email Templates
VITE_TEMPLATE_ID=
# EmailJS > Account > General > Public Key
VITE_PUBLIC_KEY=
# Google reCAPTCHA v2 (checkbox) > Site key — inclua "localhost" nos domínios para testar local
VITE_RECAPTCHA_SITE_KEY=
